{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flarc.example/security/matrix-evidence/schema.json",
  "title": "FlaRC security matrix worker evidence",
  "type": "object",
  "required": ["version", "evidence"],
  "properties": {
    "version": { "const": 2 },
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "kind", "outcome", "scenarioScope", "rationale", "basis"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
              "kind": { "const": "disposition" },
              "outcome": { "enum": ["NOT IMPLEMENTED", "NOT APPLICABLE", "BLOCKED"] },
              "scenarioScope": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "basis": { "type": "string", "minLength": 1 },
              "capability": { "type": "string" }
            }
          },
          {
            "type": "object",
            "required": ["id", "kind", "executionId", "bundleSha256", "testFile", "testTitle", "outcome", "scenarioScope", "rationale", "assertionDetails", "transports", "assertions", "dimensionDisposition"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
              "kind": { "const": "test" },
              "executionId": { "type": "string", "minLength": 1 },
              "bundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "testFile": { "type": "string", "minLength": 1 },
              "testTitle": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["PASS", "FAIL"] },
              "scenarioScope": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "assertionDetails": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "transports": { "type": "array", "items": { "type": "string" } },
              "assertions": { "type": "array", "items": { "enum": ["authorization", "state", "events", "transport", "restart", "unrelatedResources"] } },
              "dimensionDisposition": {
                "type": "object",
                "required": ["authorization", "state", "events", "transport", "restart", "unrelatedResources"],
                "additionalProperties": false,
                "properties": {
                  "authorization": { "$ref": "#/$defs/dimension" },
                  "state": { "$ref": "#/$defs/dimension" },
                  "events": { "$ref": "#/$defs/dimension" },
                  "transport": { "$ref": "#/$defs/dimension" },
                  "restart": { "$ref": "#/$defs/dimension" },
                  "unrelatedResources": { "$ref": "#/$defs/dimension" }
                }
              },
              "routeBehavior": { "type": "array", "items": { "type": "object", "required": ["route", "method", "alias", "outcome", "responseKind"], "properties": { "route": { "type": "string", "minLength": 1 }, "method": { "type": "string", "minLength": 1 }, "alias": { "type": "string", "pattern": "^/" }, "requestPath": { "type": "string", "pattern": "^/" }, "outcome": { "enum": ["positive", "negative"] }, "responseKind": { "enum": ["feature-response", "secure-denial", "missing-feature-404"] } } } },
              "commandBehavior": { "type": "array", "items": { "type": "object", "required": ["command", "outcome"], "properties": { "command": { "type": "string" }, "outcome": { "enum": ["positive", "negative"] } } } }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "dimension": {
      "oneOf": [
        { "const": "required" },
        { "type": "object", "required": ["status", "rationale"], "properties": { "status": { "const": "not-applicable" }, "rationale": { "type": "string", "minLength": 1 } } }
      ]
    }
  }
}
