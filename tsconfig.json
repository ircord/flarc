{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "~/*": [
        "./server/*"
      ],
      "@/*": [
        "./server/*"
      ]
    }
  },
  "include": [
    "server/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "nitro.config.ts"
  ],
  "exclude": [
    "old",
    ".compliance",
    "compliance",
    ".wrangler",
    "node_modules",
    ".output",
    ".nitro"
  ]
}
