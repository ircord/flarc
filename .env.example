# ==============================================================================
# FlaRC (Flare Relay Chat) Server Configuration
# Cloudflare Workers & Self-Hosted IRCv3 Server Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE NETWORK & SERVER IDENTIFICATION
# ------------------------------------------------------------------------------
# Primary server hostname advertised in IRC numeric 001 and server prefixes
SERVER_NAME="irc.flarc.local"

# Network identifier used for channel prefixes and multi-server clusters
NETWORK_NAME="FlaRC"

# Primary listening port for TCP bridge (standard IRC port 6667 or TLS 6697)
PORT=6667

# HTTP / WebSocket workerd dev server port
HTTP_PORT=8788

# Optional server-wide password required for connection (PASS command).
# If unset, connections are public and open.
# SERVER_PASSWORD="super-secret-server-password"

# Optional shared secret for WEBIRC gateway authentication (e.g. KiwiIRC, web clients).
# WEBIRC_PASSWORD="gateway-webirc-secret"

# Default IRCv3 user modes applied on registration (e.g. "+i" for invisible, or empty)
DEFAULT_USER_MODES="+i"

# Case-mapping standard: "rfc1459" (default, {}|~ match []\^) or "precis"
CASEMAPPING="rfc1459"

# draft/account-registration policy: "1" to allow before-connect, "0" to require full connection
REG_BEFORE_CONNECT="1"

# draft/account-registration email policy: "1" to require email, "0" for optional email
REG_REQUIRES_EMAIL="0"


# ------------------------------------------------------------------------------
# 2. ADMINISTRATION & SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of usernames that always possess administrator privileges.
# These users bypass channel op checks and have full access to Admin APIs and IRC oper commands.
# Example: ADMIN_USERS="karbowiak,sysadmin"
ADMIN_USERS="karbowiak"

# Master bearer token for REST Admin API endpoints (/api/v1/admin/*).
# If configured, requests with `Authorization: Bearer <ADMIN_TOKEN>` or `X-Admin-Token`
# authenticate as full server administrators.
ADMIN_TOKEN="flarc-admin-secret-token-change-in-production"

# Rate limiting window in milliseconds for spam prevention
# RATE_LIMIT_WINDOW_MS=10000

# Maximum number of commands allowed per client in the rate limit window
# RATE_LIMIT_MAX_COMMANDS=150


# ------------------------------------------------------------------------------
# 3. SERVICES & BOTS
# ------------------------------------------------------------------------------
# Whether the F (FlareServ) channel bot automatically joins newly registered channels.
# Set to "1" or "true" to auto-join, or "0" / "false" to require explicit 'ChanServ BOT ON'.
F_BOT_AUTOJOIN="0"

# Maximum backlog lines stored in ZNC/Bouncer buffers per channel/DM (default: 50)
ZNC_MAX_MESSAGES=50

# Default persistence (always-on bouncer) enabled for new registered accounts ("1" or "0")
ALWAYS_ON_DEFAULT="1"


# ------------------------------------------------------------------------------
# 4. MEDIA UPLOAD & FILE HOSTING (R2 / S3 / LOCAL)
# ------------------------------------------------------------------------------
# Whether the media upload pipeline is enabled (default: 1)
FILEHOST_ENABLED="1"

# Whether file uploads require registered account authentication (1=require account, 0=allow guests)
FILEHOST_REQUIRE_REG="1"

# Maximum allowed file upload size in megabytes (default: 25MB)
MAX_FILE_SIZE_MB=25


# ------------------------------------------------------------------------------
# 5. WEBPUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# VAPID Public Key for WebPush subscriptions (generate via web-push generate-vapid-keys)
# WEBPUSH_VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa..."

# VAPID Private Key for signing WebPush payloads
# WEBPUSH_VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"

# Subject contact email or URL for push notifications
# WEBPUSH_SUBJECT="mailto:admin@flarc.local"


# ------------------------------------------------------------------------------
# 6. WEBRTC VOICE & VIDEO (OPTIONAL)
# ------------------------------------------------------------------------------
# WebRTC media backend provider: "livekit" (self-hosted SFU) or "cloudflare" (Calls)
# VOICE_BACKEND="livekit"

# LiveKit server URL and credentials (for self-hosted SFU)
# LIVEKIT_URL="wss://livekit.flarc.local"
# LIVEKIT_API_KEY="devkey"
# LIVEKIT_API_SECRET="secret"
