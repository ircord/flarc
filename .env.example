# FlaRC deployment bindings. Keep secrets out of source control.
# Local development: export these variables before `bun run dev`.
# The dev launcher does not automatically load this file.
# Workers: configure non-secret vars / secrets using Wrangler.

SERVER_NAME="irc.flarc.local"
NETWORK_NAME="FlaRC"
# Local HTTP/WebSocket port; the optional TCP bridge binds loopback only.
PORT=8788
TCP_PORT=6667

# Secure defaults. REQUIRE_ACCOUNTS=0 and AUTO_REGISTER_CHANNELS=0 are used
# only by isolated protocol fixtures; they permit guest IRC behavior.
REQUIRE_ACCOUNTS="1"
AUTO_REGISTER_CHANNELS="1"
MIN_PASSWORD_LENGTH=12
# Account creation policy: closed, open, or invite. Registration is not login.
SIGNUP_POLICY="closed"
# SIGNUP_TOKEN=""  # invite mode: API header X-Signup-Token

# Reserved bootstrap account names. This list does not grant privileges on login.
# One configured account may be provisioned with X-Bootstrap-Token before
# any administrator has been provisioned. Then use ordinary login sessions.
ADMIN_USERS="networkadmin"
# ADMIN_TOKEN=""  # generate a random bootstrap secret; never an API bearer token

# Optional additional PASS requirement; does not replace account authentication.
# SERVER_PASSWORD=""
# WEBIRC_PASSWORD=""  # trusted gateway secret; never expose to ordinary clients
DEFAULT_USER_MODES="+i"
CASEMAPPING="rfc1459"
REG_BEFORE_CONNECT="1"
# This checks the IRC REGISTER email argument only; no email challenge/delivery
# or password-recovery flow exists. VERIFY rejects unsupported challenges.
REG_REQUIRES_EMAIL="0"

# WebSocket origins: same origin is allowed; list additional exact origins.
# These are not wildcard CORS permissions for REST.
ALLOWED_ORIGINS=""
# External fetches default off. Only explicitly trusted exact HTTPS hostnames
# are allowed. The operator also owns DNS and network egress restrictions.
EMBED_ALLOWED_HOSTS=""
OUTGOING_WEBHOOK_ALLOWED_HOSTS=""

F_BOT_AUTOJOIN="0"
ALWAYS_ON_DEFAULT="0"
# Local demo bots require existing authenticated accounts. Nothing is seeded.
# CFBOT_PASSWORD=""
# ECHO_BOT_PASSWORD=""

# All media endpoints require authentication. Uploads are private unless an
# authorized channel or DM scope is supplied. Limit: 10 MiB/request,
# 100 MiB/account. FILEHOST_REQUIRE_REG is a legacy configuration alias and
# cannot enable guest access. Bind MEDIA_BUCKET for R2; otherwise SQLite stores bytes.
FILEHOST_ENABLED="1"

# Subscription storage is supported (20/account). Encrypted WebPush delivery
# and VAPID signing are not implemented. No example key is advertised.
# WEBPUSH_VAPID_PUBLIC_KEY=""
